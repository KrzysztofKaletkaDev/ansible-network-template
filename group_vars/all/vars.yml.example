---
# ==============================================================================
# MAIN INFRASTRUCTURE VARIABLES (group_vars/all/vars.yml.example)
# Copy this file to group_vars/all/vars.yml and adjust the values to your setup.
#
# This file grows per role: each role commit appends its own block of variables
# here. Secrets never live in this file — they go into
# group_vars/routers/vault.yml (Ansible Vault). See group_vars/routers/vault.yml.example.
# ==============================================================================

# RouterOS system identity (the name shown in the CLI prompt and WinBox title).
routeros_identity: "edge-router"

# RouterOS account Ansible authenticates as over the API. This is the same
# account used for interactive SSH login — there is no separate service account
# (see docs/adr/0003-single-admin-account-over-dedicated-ansible-account.md).
# Its password lives in group_vars/routers/vault.yml as vault_routeros_api_password.
routeros_api_user: "netadmin"

# Which device this host is, so site.yml can pick the right roles. Overridden
# per group: group_vars/edge/ -> "edge", group_vars/switches/ -> "switch".
# Left empty here so a host with no group override (e.g. the CHR VM before you
# set it in group_vars/test/vars.yml) gets only the shared routeros_common role.
routeros_device_class: ""


# --- routeros_common ----------------------------------------------------------

# NTP servers for /system/ntp/client (RouterOS 7 servers table, declarative —
# entries not listed here are removed).
routeros_ntp_servers:
  - address: "0.pool.ntp.org"
  - address: "1.pool.ntp.org"

# IANA time-zone name for /system/clock.
routeros_timezone: "Europe/Warsaw"

# RouterOS permission group for routeros_api_user.
routeros_common_user_group: "full"

# Mechanism A (dead man's switch) — see roles/routeros_common/tasks/safety_snapshot.yml.
# On by default; overridden to false for the 'test' group (group_vars/test/vars.yml.example)
# because CHR has its own libvirt snapshots and a RouterOS backup would only add
# noise to the idempotence check.
routeros_enable_dead_mans_switch: true

# DEFERRED (tags: restrict-api): the address Ansible connects from. The
# restrict-api run pins the API service to <this>/32. See roles/routeros_common/README.md.
routeros_controller_ip: "10.0.0.100"

# DEFERRED (tags: disable-admin): disable the built-in 'admin' account. Only set
# true after the managed account is confirmed working, and run with --tags disable-admin.
routeros_common_disable_admin: false

# DEFERRED (tags: disable-mac-recovery): turn off MAC-Telnet / MAC-Winbox / MAC-ping.
# This is the last way onto the router without a working IP and the box has no
# serial console — only set true with or after disable-admin, never before.
routeros_common_disable_mac_recovery: false


# --- routeros_interfaces (edge only) -----------------------------------------

# LAN bridge: its name, the gateway address the router holds on it, and the
# untagged access ports that join it. ether1 is the WAN uplink and stays out of
# the bridge; the RB5009 -> CRS310 trunk port is added by a later commit, not here.
routeros_lan_bridge: "bridge-lan"
routeros_lan_address: "10.0.0.1/24"
routeros_lan_bridge_ports:
  - ether3
  - ether4
  - ether5
  - ether6
  - ether7
  - ether8
  - sfp-plus1

# WAN: the physical port to the ONT, the service-delimiting VLAN tag the ISP
# carries PPPoE over, and the derived name of the VLAN sub-interface.
routeros_wan_interface: "ether1"
routeros_wan_vlan_id: 35
routeros_wan_vlan_interface: "vlan{{ routeros_wan_vlan_id }}-wan"

# PPPoE client. Credentials live in the Vault (vault_routeros_pppoe_*).
# 1492 = 1500 - 8 (PPPoE header); MSS is additionally clamped to PMTU.
routeros_pppoe_interface: "pppoe-out1"
routeros_pppoe_mtu: 1492

# WireGuard road-warrior server. 443/udp to get through captive / restrictive
# networks; MTU 1412 leaves headroom under the PPPoE path MTU for the WireGuard
# overhead. Peer public keys and preshared keys live in the Vault
# (vault_routeros_wg_peers), keyed by the peer 'name' below.
routeros_wg_interface: "wg0"
routeros_wg_listen_port: 443
routeros_wg_mtu: 1412
routeros_wg_address: "10.100.0.1/24"
routeros_wg_peers:
  - {name: phone, allowed_address: "10.100.0.2/32"}
  - {name: tablet, allowed_address: "10.100.0.3/32"}
  - {name: laptop, allowed_address: "10.100.0.4/32"}
  - {name: phone-spare, allowed_address: "10.100.0.5/32"}


# --- VLAN segmentation (shared: edge + switch) -----------------------------
# routeros_vlans and routeros_servers_vlan_interface are read by BOTH
# routeros_interfaces (RB5009) and routeros_switch (CRS310) — the switch VLAN
# table mirrors the router's. routeros_interfaces_trunk_port is the RB5009 side
# only (the switch has its own routeros_switch_trunk_port in
# group_vars/switches). The *_hosts / *_ip vars below are consumed later by
# routeros_firewall.

# The two VLANs the LAN is split into. id 1 = main (today's flat LAN, untagged
# on the access ports); id 20 = servers. The ids are a design choice, not
# sensitive; the addresses here are placeholders (10.0.0.0/24, 10.0.20.0/24).
routeros_vlans:
  main:
    id: 1
    subnet: "10.0.0.0/24"
    gateway: "10.0.0.1"
  servers:
    id: 20
    subnet: "10.0.20.0/24"
    gateway: "10.0.20.1"

# RB5009 -> CRS310 trunk port: tagged for both VLANs, no access pvid. It is
# deliberately NOT in routeros_lan_bridge_ports — a dedicated task adds it.
routeros_interfaces_trunk_port: "ether2"

# Name of the server-VLAN sub-interface on the bridge — carries the router's
# servers-VLAN gateway address and is the SERVERS interface-list member.
routeros_servers_vlan_interface: "vlan{{ routeros_vlans.servers.id }}-servers"

# Server-VLAN host prefix, computed once by string-splitting the /24. A shape
# check only, which is enough here — no ansible.utils.ipaddr dependency.
routeros_servers_vlan_prefix: >-
  {{ routeros_vlans.servers.subnet.split('/')[0].split('.')[0:3] | join('.') }}

# Server-VLAN hosts — one list, later feeding both DHCP reservations and
# firewall rules. Real MACs live in the local group_vars/all/vars.yml; these
# are fake.
routeros_servers_vlan_hosts:
  - {name: server-a, mac: "AA:BB:CC:DD:EE:01", host_octet: 10}
  - {name: server-b, mac: "AA:BB:CC:DD:EE:02", host_octet: 11}

# Named address references for readable firewall rules (used by routeros_firewall).
routeros_qnap_native_ip: >-
  {{ routeros_servers_vlan_prefix }}.{{ routeros_servers_vlan_hosts
     | selectattr('name', 'equalto', 'server-a') | map(attribute='host_octet') | first }}
routeros_alma_ip: >-
  {{ routeros_servers_vlan_prefix }}.{{ routeros_servers_vlan_hosts
     | selectattr('name', 'equalto', 'server-b') | map(attribute='host_octet') | first }}
