---
# ==============================================================================
# MAIN INFRASTRUCTURE VARIABLES (group_vars/all/vars.yml.example)
# Copy this file to group_vars/all/vars.yml and adjust the values to your setup.
#
# This file grows per role: each role commit appends its own block of variables
# here. Secrets never live in this file — they go into
# group_vars/routers/vault.yml (Ansible Vault). See group_vars/routers/vault.yml.example.
# ==============================================================================

# RouterOS system identity (the name shown in the CLI prompt and WinBox title).
routeros_identity: "edge-router"

# RouterOS account Ansible authenticates as over the API. This is the same
# account used for interactive SSH login — there is no separate service account
# (see docs/adr/0003-single-admin-account-over-dedicated-ansible-account.md).
# Its password lives in group_vars/routers/vault.yml as vault_routeros_api_password.
routeros_api_user: "netadmin"

# Which device this host is, so site.yml can pick the right roles. Overridden
# per group: group_vars/edge/ -> "edge", group_vars/switches/ -> "switch".
# Left empty here so a host with no group override (e.g. the CHR VM before you
# set it in group_vars/test/vars.yml) gets only the shared routeros_common role.
routeros_device_class: ""


# --- routeros_common ----------------------------------------------------------

# NTP servers for /system/ntp/client (RouterOS 7 servers table, declarative —
# entries not listed here are removed).
routeros_ntp_servers:
  - address: "0.pool.ntp.org"
  - address: "1.pool.ntp.org"

# IANA time-zone name for /system/clock.
routeros_timezone: "Europe/Warsaw"

# RouterOS permission group for routeros_api_user.
routeros_common_user_group: "full"

# Mechanism A (dead man's switch) — see roles/routeros_common/tasks/safety_snapshot.yml.
# On by default; overridden to false for the 'test' group (group_vars/test/vars.yml.example)
# because CHR has its own libvirt snapshots and a RouterOS backup would only add
# noise to the idempotence check.
routeros_enable_dead_mans_switch: true

# DEFERRED (tags: restrict-api): the address Ansible connects from. The
# restrict-api run pins the API service to <this>/32. See roles/routeros_common/README.md.
#
# MUST be outside routeros_dhcp_pool_ranges.main (below), and held statically by
# the control node — not leased to it. Inside the pool, DHCP can hand this exact
# address to some other client, and two rules key off it by src-address: the
# "control node to switch" accept (that client gets SSH/Winbox/API to the CRS310
# and Ansible loses it) and, once restrict-api has been run, /ip service api
# itself — at which point the stray client is the only host allowed to reach the
# router's API and the control node is locked out.
routeros_controller_ip: "10.0.0.10"

# DEFERRED (tags: disable-admin): disable the built-in 'admin' account. Only set
# true after the managed account is confirmed working, and run with --tags disable-admin.
routeros_common_disable_admin: false

# DEFERRED (tags: disable-mac-recovery): turn off MAC-Telnet / MAC-Winbox / MAC-ping.
# This is the last way onto the router without a working IP and the box has no
# serial console — only set true with or after disable-admin, never before.
routeros_common_disable_mac_recovery: false


# --- routeros_interfaces (edge only) -----------------------------------------

# LAN bridge: its name, the gateway address the router holds on it, and the
# untagged access ports that join it. The WAN port and the RB5009 -> CRS310
# trunk port stay out of this list (the trunk is added by its own task).
#
# Port assignment on the RB5009 (7x 1G on ether2-ether8, 2.5G on ether1,
# 10G SFP+ on sfp-sfpplus1):
#   ether1        -> trunk to the CRS310 (the only 2.5G copper port; the trunk
#                    carries inter-VLAN traffic and benefits from 2.5G)
#   ether2        -> WAN (1G is ~3x the 300/300 line rate — no bottleneck)
#   ether3-ether8 -> LAN access, VLAN main (PoE-out for the cameras)
#   sfp-sfpplus1  -> LAN access, VLAN main (spare; no module fitted today)
routeros_lan_bridge: "bridge-lan"
routeros_lan_address: "10.0.0.1/24"
routeros_lan_bridge_ports:
  - ether3
  - ether4
  - ether5
  - ether6
  - ether7
  - ether8
  - sfp-sfpplus1

# WAN: the physical port to the ONT, the service-delimiting VLAN tag the ISP
# carries PPPoE over, and the derived name of the VLAN sub-interface.
routeros_wan_interface: "ether2"
routeros_wan_vlan_id: 35
routeros_wan_vlan_interface: "vlan{{ routeros_wan_vlan_id }}-wan"

# PPPoE client. Credentials live in the Vault (vault_routeros_pppoe_*).
# 1492 = 1500 - 8 (PPPoE header); MSS is additionally clamped to PMTU.
routeros_pppoe_interface: "pppoe-out1"
routeros_pppoe_mtu: 1492

# WireGuard road-warrior server. 443/udp to get through captive / restrictive
# networks; MTU 1412 leaves headroom under the PPPoE path MTU for the WireGuard
# overhead. Peer public keys and preshared keys live in the Vault
# (vault_routeros_wg_peers), keyed by the peer 'name' below.
routeros_wg_interface: "wg0"
routeros_wg_listen_port: 443
routeros_wg_mtu: 1412
routeros_wg_address: "10.100.0.1/24"
routeros_wg_peers:
  - {name: phone, allowed_address: "10.100.0.2/32"}
  - {name: tablet, allowed_address: "10.100.0.3/32"}
  - {name: laptop, allowed_address: "10.100.0.4/32"}
  - {name: phone-spare, allowed_address: "10.100.0.5/32"}


# --- VLAN segmentation (shared: edge + switch) -----------------------------
# routeros_vlans and routeros_servers_vlan_interface are read by BOTH
# routeros_interfaces (RB5009) and routeros_switch (CRS310) — the switch VLAN
# table mirrors the router's. routeros_interfaces_trunk_port is the RB5009 side
# only (the switch has its own routeros_switch_trunk_port in
# group_vars/switches). The *_hosts / *_ip vars below are consumed later by
# routeros_firewall.

# The two VLANs the LAN is split into. id 1 = main (today's flat LAN, untagged
# on the access ports); id 20 = servers. The ids are a design choice, not
# sensitive; the addresses here are placeholders (10.0.0.0/24, 10.0.20.0/24).
routeros_vlans:
  main:
    id: 1
    subnet: "10.0.0.0/24"
    gateway: "10.0.0.1"
  servers:
    id: 20
    subnet: "10.0.20.0/24"
    gateway: "10.0.20.1"

# RB5009 -> CRS310 trunk port: tagged for both VLANs, no access pvid. It is
# deliberately NOT in routeros_lan_bridge_ports — a dedicated task adds it.
# ether1 is the RB5009's only 2.5G copper port; the trunk carries all
# inter-VLAN traffic, so it gets the fast port. WAN goes on 1G ether2.
routeros_interfaces_trunk_port: "ether1"

# Name of the server-VLAN sub-interface on the bridge — carries the router's
# servers-VLAN gateway address and is the SERVERS interface-list member.
routeros_servers_vlan_interface: "vlan{{ routeros_vlans.servers.id }}-servers"

# CRS310 management address (host part only). Shared: group_vars/switches builds
# routeros_switch_mgmt_address from it, and routeros_firewall uses it for the
# "control node -> switch" accept rule. Keep in sync with the crs310 ansible_host
# in inventory/hosts.yml (see "Otwarte decyzje" in the plan).
routeros_switch_mgmt_ip: "10.0.20.2"

# Server-VLAN host prefix, computed once by string-splitting the /24. A shape
# check only, which is enough here — no ansible.utils.ipaddr dependency.
routeros_servers_vlan_prefix: >-
  {{ routeros_vlans.servers.subnet.split('/')[0].split('.')[0:3] | join('.') }}

# Server-VLAN hosts — one list feeding both DHCP reservations (routeros_dhcp) and
# firewall rules (routeros_firewall). MUST contain 'qnap-native' and 'alma' —
# the reference vars below resolve those names. Real MACs live in the local
# group_vars/all/vars.yml; these are fake.
routeros_servers_vlan_hosts:
  - {name: qnap-native, mac: "AA:BB:CC:DD:EE:10", host_octet: 10}
  - {name: alma, mac: "AA:BB:CC:DD:EE:11", host_octet: 11}
  - {name: nucbox, mac: "AA:BB:CC:DD:EE:36", host_octet: 136}
  - {name: imac, mac: "AA:BB:CC:DD:EE:C0", host_octet: 192}

# Named address references for readable firewall rules (used by routeros_firewall).
# routeros_dhcp asserts that 'qnap-native' / 'alma' exist so these never resolve
# `first` on an empty match.
routeros_qnap_native_ip: >-
  {{ routeros_servers_vlan_prefix }}.{{ routeros_servers_vlan_hosts
     | selectattr('name', 'equalto', 'qnap-native') | map(attribute='host_octet') | first }}
routeros_alma_ip: >-
  {{ routeros_servers_vlan_prefix }}.{{ routeros_servers_vlan_hosts
     | selectattr('name', 'equalto', 'alma') | map(attribute='host_octet') | first }}


# --- routeros_dhcp (edge only) --------------------------------------------------

# Which bridge interface serves DHCP for each VLAN key in routeros_vlans.
routeros_dhcp_networks:
  - {vlan: main, interface: "{{ routeros_lan_bridge }}"}
  - {vlan: servers, interface: "{{ routeros_servers_vlan_interface }}"}

# Dynamic pool range per VLAN — must sit outside the static-reservation band,
# and must NOT contain routeros_controller_ip (see the note there). RouterOS
# takes this string verbatim, so a comma-separated list works if a hole is ever
# needed: "10.0.0.50-10.0.0.99,10.0.0.101-10.0.0.240".
routeros_dhcp_pool_ranges:
  main: "10.0.0.50-10.0.0.240"
  servers: "10.0.20.50-10.0.20.240"

routeros_dhcp_lease_time: "1d"

# Static reservations on VLAN main. The real table (~14 entries) lives in the
# local group_vars/all/vars.yml; these are placeholders. Server-VLAN
# reservations are derived from routeros_servers_vlan_hosts, not listed here.
routeros_dhcp_leases:
  - {name: example-nas, mac: "AA:BB:CC:DD:EE:20", ip: "10.0.0.20"}
  - {name: example-printer, mac: "AA:BB:CC:DD:EE:21", ip: "10.0.0.21"}


# --- routeros_dns (edge only) ------------------------------------------------

# The router's /ip dns forwards here — the ad-blocking resolver on the server
# VLAN (ADR-0004). Derived from routeros_alma_ip.
routeros_dns_primary_upstream: "{{ routeros_alma_ip }}"

# Where Netwatch swings the upstream when the primary is unreachable. Public
# resolvers — there is no second local DNS node, so the LAN loses ad-blocking
# until the primary recovers (ADR-0004).
routeros_dns_fallback_upstream:
  - "1.1.1.1"
  - "9.9.9.9"

# Bare integer, no "KiB" suffix: the RouterOS API returns cache-size as a plain
# number (the CLI display adds KiB, the API value does not). A suffixed string
# makes api_modify see a mismatch every run.
routeros_dns_cache_size: 4096
routeros_dns_netwatch_interval: "30s"

# Static A records the router answers directly. name -> address.
routeros_dns_static:
  - {name: "router.lan", address: "10.0.0.1"}


# --- routeros_firewall (edge only) ------------------------------------------

# Firewall address lists. routeros_firewall OWNS exactly these list names
# (handle_absent_entries=remove is restricted to them); entries in any other
# list are left alone.
#   doh-resolvers      - public DoH endpoints, blocked on :443 from the LAN
#   doh-exempt         - hosts allowed to reach doh-resolvers (the ad-blocker,
#                        which uses DoH upstream)
#   dns-nat-exempt     - hosts NOT redirected on :53 (the ad-blocker itself)
#   qnap-native-access - who may reach the native NAS on :443 across the segment
#   wg-trusted         - WireGuard peers with unrestricted server-VLAN access
routeros_firewall_address_lists:
  doh-resolvers:
    - "1.1.1.1"
    - "1.0.0.1"
    - "8.8.8.8"
    - "8.8.4.4"
    - "9.9.9.9"
    - "149.112.112.112"
  doh-exempt:
    - "{{ routeros_alma_ip }}"
  dns-nat-exempt:
    - "{{ routeros_alma_ip }}"
  qnap-native-access:
    - "10.0.0.113"
    - "10.100.0.3"
    - "10.100.0.5"
  wg-trusted:
    - "10.100.0.2"
    - "10.100.0.4"
