---
# ==============================================================================
# ENCRYPTED SECRETS TEMPLATE (group_vars/routers/vault.yml.example)
# Copy this file to group_vars/routers/vault.yml, fill in real values, then:
#   ansible-vault encrypt group_vars/routers/vault.yml
#
# The decrypted vault.yml is never committed — .gitignore enforces this.
# This file grows per role, in step with group_vars/all/vars.yml.example.
# ==============================================================================

# Password for the RouterOS account Ansible uses (routeros_api_user). The same
# account is used for interactive SSH login (key-based; this password is the
# API credential).
vault_routeros_api_password: "CHANGE_ME_STRONG_PASSWORD"


# --- routeros_interfaces -----------------------------------------------------

# PPPoE credentials from your ISP. Do not hardcode these anywhere else.
vault_routeros_pppoe_user: "PPPOE_USERNAME_CHANGE_ME"
vault_routeros_pppoe_password: "PPPOE_PASSWORD_CHANGE_ME"

# WireGuard server private key. Generate it on the router and read it back:
#   /interface/wireguard/add name=wg0
#   /interface/wireguard/print
vault_routeros_wg_private_key: "SERVER_WIREGUARD_PRIVATE_KEY_CHANGE_ME"

# Per-peer public key, keyed by the peer 'name' in routeros_wg_peers
# (group_vars/all/vars.yml). One keypair per device.
#
# preshared_key is OPTIONAL — add it per peer only if you want the extra
# symmetric layer; when absent, routeros_interfaces omits the field:
#   phone:
#     public_key: "..."
#     preshared_key: "..."   # optional
vault_routeros_wg_peers:
  phone:
    public_key: "PEER_PUBLIC_KEY_CHANGE_ME"
  tablet:
    public_key: "PEER_PUBLIC_KEY_CHANGE_ME"
  laptop:
    public_key: "PEER_PUBLIC_KEY_CHANGE_ME"
  phone-spare:
    public_key: "PEER_PUBLIC_KEY_CHANGE_ME"
